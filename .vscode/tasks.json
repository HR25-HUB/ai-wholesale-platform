{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install dependencies",
      "type": "shell",
      "command": ".venv/Scripts/pip install -e .",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Run tests",
      "type": "shell",
      "command": ".venv/Scripts/python -m pytest tests/ -v --tb=short",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Dashboard Factory: Sync",
      "type": "shell",
      "command": "uv sync --all-groups",
      "options": {
        "cwd": "${workspaceFolder}/services/dashboard_factory"
      },
      "problemMatcher": []
    },
    {
      "label": "Dashboard Factory: Verify Golden Metric",
      "type": "shell",
      "command": "uv run dashboard-factory verify-metric --dataset tests/golden/rfq_offer_conversion.jsonl --contract metrics/sales/rfq_offer_conversion.yaml --dataset-id golden-rfq-offer-conversion-v1 --evidence-out evidence/df-001-2/metric_evidence.json",
      "options": {
        "cwd": "${workspaceFolder}/services/dashboard_factory"
      },
      "problemMatcher": []
    },
    {
      "label": "Dashboard Factory: Quality Gates",
      "type": "shell",
      "command": "uv run ruff check . && uv run ruff format --check . && uv run pyrefly check && uv run pytest -q",
      "options": {
        "cwd": "${workspaceFolder}/services/dashboard_factory"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Dashboard Factory: Tests",
      "type": "shell",
      "command": "uv run pytest -q",
      "options": {
        "cwd": "${workspaceFolder}/services/dashboard_factory"
      },
      "problemMatcher": []
    },
    {
      "label": "Docker: Up",
      "type": "shell",
      "command": "docker compose -f infra/docker-compose.yml up -d",
      "problemMatcher": []
    },
    {
      "label": "Docker: Down",
      "type": "shell",
      "command": "docker compose -f infra/docker-compose.yml down",
      "problemMatcher": []
    },
    {
      "label": "Docker: Logs",
      "type": "shell",
      "command": "docker compose -f infra/docker-compose.yml logs -f --tail=50",
      "problemMatcher": [],
      "isBackground": true
    },
    {
      "label": "Bootstrap OpenSearch",
      "type": "shell",
      "command": ".venv/Scripts/python scripts/bootstrap_opensearch.py",
      "problemMatcher": []
    },
    {
      "label": "FastAPI: Run dev server",
      "type": "shell",
      "command": ".venv/Scripts/python -m uvicorn app.main:app --reload --port 8000",
      "problemMatcher": [],
      "isBackground": true
    },
    {
      "label": "Ruff: Check",
      "type": "shell",
      "command": ".venv/Scripts/python -m ruff check .",
      "problemMatcher": []
    },
    {
      "label": "Ruff: Format",
      "type": "shell",
      "command": ".venv/Scripts/python -m ruff format .",
      "problemMatcher": []
    }
  ]
}
