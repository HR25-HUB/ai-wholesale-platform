{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install dependencies",
      "type": "shell",
      "command": ".venv/Scripts/pip install -e .",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Run tests",
      "type": "shell",
      "command": ".venv/Scripts/python -m pytest tests/ -v --tb=short",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Docker: Up",
      "type": "shell",
      "command": "docker compose -f infra/docker-compose.yml up -d",
      "problemMatcher": []
    },
    {
      "label": "Docker: Down",
      "type": "shell",
      "command": "docker compose -f infra/docker-compose.yml down",
      "problemMatcher": []
    },
    {
      "label": "Docker: Logs",
      "type": "shell",
      "command": "docker compose -f infra/docker-compose.yml logs -f --tail=50",
      "problemMatcher": [],
      "isBackground": true
    },
    {
      "label": "Bootstrap OpenSearch",
      "type": "shell",
      "command": ".venv/Scripts/python scripts/bootstrap_opensearch.py",
      "problemMatcher": []
    },
    {
      "label": "FastAPI: Run dev server",
      "type": "shell",
      "command": ".venv/Scripts/python -m uvicorn app.main:app --reload --port 8000",
      "problemMatcher": [],
      "isBackground": true
    },
    {
      "label": "Ruff: Check",
      "type": "shell",
      "command": ".venv/Scripts/python -m ruff check .",
      "problemMatcher": []
    },
    {
      "label": "Ruff: Format",
      "type": "shell",
      "command": ".venv/Scripts/python -m ruff format .",
      "problemMatcher": []
    }
  ]
}
